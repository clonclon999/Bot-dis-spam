# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - DISCORD ANTI-SPAM BOT
# Sao chép tệp này thành `.env` và điền thông tin thực tế của bạn.
# TUYỆT ĐỐI KHÔNG chia sẻ hoặc commit tệp `.env` lên GitHub!
# ============================================================================

# [BẮT BUỘC] Token của Discord Bot (lấy tại Discord Developer Portal -> Bot)
DISCORD_TOKEN=your_discord_bot_token_here

# [BẮT BUỘC ĐỂ ĐĂNG KÝ LỆNH] Application ID / Client ID của Bot
CLIENT_ID=your_discord_application_client_id_here

# [TÙY CHỌN] Guild ID để đăng ký lệnh tức thì cho 1 máy chủ thử nghiệm
# Để trống nếu muốn đăng ký Slash Command toàn cục (Global) cho mọi máy chủ
DEV_GUILD_ID=

# [TÙY CHỌN] Tự động đồng bộ Slash Commands khi khởi động bot (true / false)
AUTO_DEPLOY_COMMANDS=true

# [TÙY CHỌN] Đường dẫn thư mục lưu trữ cấu hình và lịch sử bền vững
DATA_DIR=./data

# [TÙY CHỌN] Mức độ ghi log ra console: debug | info | warn | error
LOG_LEVEL=info

# [TÙY CHỌN - CLOUD] Cổng HTTP Healthcheck (Render, Railway, Fly.io, Koyeb...)
# Để trống nếu chạy trên VPS thông thường không yêu cầu cổng HTTP
PORT=
