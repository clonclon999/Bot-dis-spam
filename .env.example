# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG — DISCORD GAME BOT PRO & ANTI-SPAM SYSTEM
# Sao chép tệp này thành `.env` (hoặc điền vào mục Environment Variables trên BotKeep).
# TUYỆT ĐỐI KHÔNG chia sẻ hoặc đẩy tệp `.env` chứa Token thật lên GitHub!
# (Ghi chú: OWNER tối cao 1243061570247069696 đã được cố định cứng trong mã nguồn).
# ============================================================================

# [BẮT BUỘC] Token của Discord Bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# [BẮT BUỘC ĐỂ ĐĂNG KÝ SLASH COMMAND] Application ID / Client ID của Bot
CLIENT_ID=your_discord_application_client_id_here

# [TÙY CHỌN] Guild ID để đồng bộ lệnh tức thì cho 1 máy chủ thử nghiệm
# Để trống để Bot tự động đăng ký 36 Slash Commands Toàn cục (Global) cho mọi Server
DEV_GUILD_ID=

# [TÙY CHỌN] Tự động đồng bộ 36 Slash Commands ngay khi Bot khởi động (true / false)
AUTO_DEPLOY_COMMANDS=true

# [TÙY CHỌN] Thư mục lưu trữ bền vững SQLite (`gamebot-pro.sqlite`), Backup & cấu hình Anti-Spam
DATA_DIR=./data

# [TÙY CHỌN] Mức độ ghi log ra console: debug | info | warn | error
LOG_LEVEL=info

# [TÙY CHỌN - CLOUD] Cổng HTTP Healthcheck (chỉ điền nếu nền tảng Cloud yêu cầu mở cổng Web)
PORT=
